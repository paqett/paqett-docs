# The docs container's own Caddy: plain HTTP on :8080, files only. TLS, compression, security
# headers and the PostHog proxy are the main Caddy's job (docs.paqett.com.caddyfile).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv

	# Hashed build assets never change; share images change rarely.
	header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
	header /og/* Cache-Control "public, max-age=86400"

	# Pages are prerendered as /guides/x.html and linked without the extension.
	try_files {path}.html {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
